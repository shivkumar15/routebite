VITE_APP_NAME=RouteBite

# Phase 16 — public browser key restricted by HTTP referrer and enabled API.
# Enable Maps JavaScript API, Places API (New) and Geocoding API.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Optional Google Cloud map ID. Local development falls back to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=

# Never enable this in a public production build. Vite development enables the fallback automatically.
VITE_ENABLE_COORDINATE_FALLBACK=false
