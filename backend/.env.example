NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Copy this file to .env and replace the placeholders with your real Atlas credentials.
# Never commit the real .env file.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/routebite?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Later phases
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
