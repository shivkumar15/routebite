NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Copy this file to .env and replace the placeholders with your real Atlas credentials.
# Never commit the real .env file.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/routebite?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Phase 2 — email verification.
# Without RESEND_API_KEY in development, RouteBite falls back to printing the email OTP in the backend terminal.
# onboarding@resend.dev can send only to the email tied to your Resend account; use a verified domain for other recipients.
RESEND_API_KEY=
RESEND_FROM_EMAIL=RouteBite <onboarding@resend.dev>

# Phase 2 — private partner verification uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 5 — Razorpay Test Mode.
# Generate Test Mode API keys in the Razorpay dashboard. Never expose KEY_SECRET to the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional for local/manual checkout; required when webhook handling is configured/reachable.
RAZORPAY_WEBHOOK_SECRET=

# Later phases
GOOGLE_MAPS_API_KEY=
